# Región de AWS donde se invoca Amazon Bedrock
AWS_REGION=us-east-1

# Identificador del modelo de Bedrock a utilizar (Claude 3.5 Sonnet)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Ruta al archivo de base de datos SQLite (relativa o absoluta)
DB_PATH=max_data.db

# Nivel de detalle en los logs de la aplicación (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
